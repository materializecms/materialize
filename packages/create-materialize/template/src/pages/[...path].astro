---
import Page from '@materializecms/astro/components/Page.astro'
import { type Entry, getRoutes } from '@materializecms/astro/content'
import Site from '../layouts/Site.astro'

// One static page for every published document that has an address.
// Until a home page is published, the home shows how to start.
export async function getStaticPaths() {
  const routes: { params: { path: string | undefined }; props: { entry: Entry | null } }[] = await getRoutes()
  if (!routes.some((r) => r.params.path === undefined)) routes.push({ params: { path: undefined }, props: { entry: null } })
  return routes
}

const { entry } = Astro.props as { entry: Entry | null }
---

{
  entry ? (
    <Site title={entry.title} entry={entry}>
      <Page sections={entry.data.page} document={entry} />
    </Site>
  ) : (
    <Site title="Benvenuto">
      <main class="welcome">
        <p class="eyebrow">Materialize</p>
        <h1>Il sito è pronto.</h1>
        <p>Apri il pannello, crea una pagina con indirizzo <code>home</code> e pubblicala: comparirà qui.</p>
        <a href="/admin">Apri il pannello →</a>
      </main>
    </Site>
  )
}

<style>
  .welcome {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(96px, 16vw, 200px) 24px;
    font-family: 'Geist Variable', system-ui, sans-serif;
  }
  .eyebrow {
    font: 500 12px/1 'Geist Mono Variable', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  h1 {
    margin: 20px 0 0;
    font: 400 clamp(48px, 8vw, 92px) / 1 'Instrument Serif', Georgia, serif;
    letter-spacing: -0.025em;
  }
  p {
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.75;
  }
  code {
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 6px;
    background: rgb(127 127 127 / 0.14);
  }
  a {
    display: inline-flex;
    margin-top: 36px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #a8502a;
    color: #fff;
    font-weight: 500;
    text-decoration: none;
  }
</style>
