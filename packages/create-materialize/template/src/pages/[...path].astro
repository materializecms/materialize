---
import Comments from '@materializecms/astro/components/Comments.astro'
import Page from '@materializecms/astro/components/Page.astro'
import { type Entry, getLocales, getRoutes, getTemplate } from '@materializecms/astro/content'
import Site from '../layouts/Site.astro'
import Article from '../templates/Article.astro'
import Welcome from '../templates/Welcome.astro'

// One static page for every published document that has an address.
// Until a home page is published, the home shows how to start.
export async function getStaticPaths() {
  const routes: { params: { path: string | undefined }; props: { entry: Entry | null } }[] = await getRoutes()
  if (!routes.some((r) => r.params.path === undefined)) routes.push({ params: { path: undefined }, props: { entry: null } })
  return routes
}

const { entry } = Astro.props as { entry: Entry | null }
// Pages are drawn on the canvas. Other documents, such as articles, take the look of the page
// chosen as their collection's template (Modello → Articoli); without one, a plain readable page.
// Below them, visitors' comments where Impostazioni → Commenti turns them on.
const canvas = Array.isArray(entry?.data.page)
const template = entry && !canvas ? await getTemplate(entry.collection, entry.locale) : null
const welcome = (await getLocales()).default.startsWith('it') ? 'Benvenuto' : 'Welcome'
---

{
  !entry ? (
    <Site title={welcome}>
      <Welcome />
    </Site>
  ) : canvas ? (
    <Site title={entry.title} entry={entry}>
      <Page sections={entry.data.page} document={entry} main />
    </Site>
  ) : template ? (
    <Site title={entry.title} entry={entry}>
      <Page sections={template} entry={entry} document={entry} main />
      <Comments entry={entry} />
    </Site>
  ) : (
    <Site title={entry.title} entry={entry}>
      <Article entry={entry} />
      <Comments entry={entry} />
    </Site>
  )
}
