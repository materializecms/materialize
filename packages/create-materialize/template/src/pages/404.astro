---
import { getLocales } from '@materializecms/astro/content'
import Site from '../layouts/Site.astro'

// In the site's main language: Italian, or English for every other one.
const it = (await getLocales()).default.startsWith('it')
---

<Site title={it ? 'Pagina non trovata' : 'Page not found'}>
  <main>
    {
      it ? (
        <>
          <h1>Questa pagina non c’è.</h1>
          <p>
            Forse è stata spostata. <a href="/">Torna alla home</a>.
          </p>
        </>
      ) : (
        <>
          <h1>This page doesn’t exist.</h1>
          <p>
            Maybe it was moved. <a href="/">Back to the home page</a>.
          </p>
        </>
      )
    }
  </main>
</Site>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 160px 24px;
    font-family: 'Geist Variable', system-ui, sans-serif;
  }
  h1 {
    margin: 0;
    font: 600 clamp(40px, 6vw, 72px) / 1.05 'Geist Variable', system-ui, sans-serif;
    letter-spacing: -0.035em;
  }
  p {
    margin-top: 24px;
    font-size: 18px;
  }
</style>
