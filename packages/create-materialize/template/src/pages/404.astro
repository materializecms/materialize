---
import Site from '../layouts/Site.astro'
---

<Site title="Pagina non trovata">
  <section class="wrap missing">
    <h1>Questa pagina non c’è.</h1>
    <p>Forse è stata spostata. <a href="/">Torna alla home</a>.</p>
  </section>
</Site>

<style>
  .missing {
    padding: 160px 0;
  }
  h1 {
    font-size: clamp(48px, 7vw, 96px);
  }
  p {
    margin-top: 24px;
    color: var(--ink-2);
  }
</style>
