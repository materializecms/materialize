---
import RichText from '@materializecms/astro/components/RichText.astro'
import type { RichText as RichTextValue } from '@materializecms/core'

interface Props {
  title?: string
  body: RichTextValue
  field: (name: string) => Record<string, string>
}

const { title, body, field } = Astro.props
---

<section class="text section">
  <div class="wrap grid">
    {title ? <h2 {...field('title')}>{title}</h2> : <span />}
    <RichText value={body} class="prose" />
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 28px;
  }
  h2 {
    font-size: clamp(36px, 4.5vw, 56px);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: 72px;
    }
  }
</style>
