---
import { getSingleton } from '@materializecms/astro/content'
import type { Link } from '@materializecms/core'

interface Props {
  title: string
  text?: string
  link?: Link
  field: (name: string) => Record<string, string>
}

const { title, text, link, field } = Astro.props
// Contact details are entered once, in the site settings.
const contacts = (await getSingleton('settings'))?.data.contacts ?? {}
---

<section class="contact section">
  <div class="wrap grid">
    <div>
      <h2 {...field('title')}>{title}</h2>
      {text && <p class="soft lead" {...field('text')}>{text}</p>}
      {link?.href && <a class="button" href={link.href}>{link.label || 'Scrivici'}</a>}
    </div>
    <dl>
      {
        contacts.email && (
          <div>
            <dt class="soft">Email</dt>
            <dd>
              <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
            </dd>
          </div>
        )
      }
      {
        contacts.phone && (
          <div>
            <dt class="soft">Telefono</dt>
            <dd>
              <a href={`tel:${contacts.phone.replace(/\s+/g, '')}`}>{contacts.phone}</a>
            </dd>
          </div>
        )
      }
      {
        contacts.address && (
          <div>
            <dt class="soft">Indirizzo</dt>
            <dd class="address">{contacts.address}</dd>
          </div>
        )
      }
    </dl>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
  h2 {
    font-size: clamp(44px, 6vw, 84px);
  }
  .lead {
    margin-top: 20px;
    max-width: 44ch;
    font-size: 19px;
  }
  .button {
    margin-top: 32px;
  }
  dl {
    display: grid;
    gap: 22px;
    margin: 0;
  }
  dt {
    font-size: 13px;
  }
  dd {
    margin: 4px 0 0;
    font-size: 20px;
  }
  dd a {
    text-decoration: none;
  }
  dd a:hover {
    color: var(--accent);
  }
  .address {
    white-space: pre-line;
  }
</style>
