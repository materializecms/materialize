---
interface Props {
  eyebrow?: string
  title: string
  items?: { title: string; text?: string }[]
  field: (name: string) => Record<string, string>
}

const { eyebrow, title, items = [], field } = Astro.props
---

<section class="services section">
  <div class="wrap">
    {eyebrow && <p class="eyebrow" {...field('eyebrow')}>{eyebrow}</p>}
    <h2 {...field('title')}>{title}</h2>
    <ol>
      {
        items.map((item, i) => (
          <li>
            <span class="n soft">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            {item.text && <p class="soft">{item.text}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .eyebrow {
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(40px, 5.5vw, 72px);
    max-width: 16ch;
    margin-bottom: 56px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 40px;
  }
  @media (min-width: 800px) {
    ol {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  li {
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    padding: 24px 0 40px;
  }
  .n {
    font-size: 13px;
    letter-spacing: 0.1em;
  }
  h3 {
    margin-top: 16px;
    font-size: 30px;
  }
  p {
    margin-top: 12px;
    font-size: 16px;
  }
</style>
