---
// Every font a theme can choose: browsers download only the ones a page uses.
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '@fontsource/instrument-serif'
import '@fontsource-variable/fraunces'
import '@fontsource-variable/inter'
import Tracking from '@materializecms/astro/components/Tracking.astro'
import { type Entry, getSingleton, getTheme } from '@materializecms/astro/content'
import { pageRootStyle } from '@materializecms/core/page'

interface Props {
  title: string
  description?: string
  entry?: Entry
  /** Rendered inside the editor canvas. */
  preview?: boolean
}

const { title, description, entry } = Astro.props
const settings = await getSingleton('settings')
const siteName: string = settings?.data.siteName ?? '__SITE_NAME__'
const seo = entry?.data.seo ?? {}
const pageTitle = seo.title || (entry?.url === '/' ? siteName : `${title} · ${siteName}`)
const metaDescription = seo.description || description
const root = pageRootStyle(await getTheme())
---

<!doctype html>
<html lang={entry?.locale ?? 'it'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {seo.noindex && <meta name="robots" content="noindex" />}
    {seo.image?.src && <meta property="og:image" content={seo.image.src} />}
    <meta property="og:title" content={pageTitle} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Tracking lang={entry?.locale} />
    {Astro.site && entry?.url && <link rel="canonical" href={new URL(entry.url, Astro.site)} />}
  </head>
  <body style={root}>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
</style>
