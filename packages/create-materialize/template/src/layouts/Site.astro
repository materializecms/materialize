---
// Every font a theme can choose: browsers download only the ones a page uses.
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '@fontsource/instrument-serif'
import '@fontsource-variable/fraunces'
import '@fontsource-variable/inter'
import Seo from '@materializecms/astro/components/Seo.astro'
import Tracking from '@materializecms/astro/components/Tracking.astro'
import { type Entry, getLocales, getSingleton, getSiteSeo, getTheme } from '@materializecms/astro/content'
import { pageRootStyle } from '@materializecms/core/page'

interface Props {
  title: string
  description?: string
  entry?: Entry
  /** Rendered inside the editor canvas. */
  preview?: boolean
}

const { title, description, entry } = Astro.props
const settings = await getSingleton('settings')
const siteName: string = settings?.data.siteName ?? '__SITE_NAME__'
const root = pageRootStyle(await getTheme())
const lang = entry?.locale ?? (await getLocales()).default
// The favicon chosen in Impostazioni → SEO replaces the starter's one.
const favicon = (await getSiteSeo()).favicon?.src
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Title, description, sharing cards, canonical, other languages, structured data, feeds. */}
    <Seo entry={entry} title={title} description={description} siteName={siteName} />
    {!favicon && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    <Tracking lang={entry?.locale} />
  </head>
  <body style={root}>
    {/* No <main> here: canvas pages put their own around the content (Page main), between their
        menu and footer sections, so those stay the page's banner and contentinfo. */}
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
</style>
