---
/**
 * An article until a page is chosen as the template of Articoli: title, date, cover and text,
 * in the site's colors and fonts. Draw a page on the canvas and pick Modello → Articoli to
 * give every article the site's menu, footer and look.
 */
import Media from '@materializecms/astro/components/Media.astro'
import RichText from '@materializecms/astro/components/RichText.astro'
import type { Entry } from '@materializecms/astro/content'

interface Props {
  entry: Entry
}

const { entry } = Astro.props
const { date, excerpt, cover, body } = entry.data
const when = typeof date === 'string' ? new Date(date) : null
const locale = entry.locale || 'it'
---

<main class="article">
  <a class="back" href="/">← Home</a>
  <header>
    {
      when && !Number.isNaN(when.getTime()) && (
        <time datetime={date}>{when.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      )
    }
    <h1>{entry.title}</h1>
    {excerpt && <p class="excerpt">{excerpt}</p>}
  </header>
  {cover?.src && <Media media={cover} class="cover" priority sizes="(min-width: 800px) 760px, 100vw" />}
  {body?.length > 0 && <RichText value={body} class="body" />}
</main>

<style>
  .article {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) 24px clamp(64px, 10vw, 128px);
  }
  .back {
    font-size: 14px;
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
  }
  .back:hover {
    opacity: 1;
  }
  header {
    margin-top: 40px;
  }
  time {
    font-size: 14px;
    opacity: 0.6;
  }
  h1 {
    margin: 12px 0 0;
    font-family: var(--mz-display, inherit);
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .excerpt {
    margin: 20px 0 0;
    font-size: 20px;
    line-height: 1.5;
    opacity: 0.75;
  }
  .article :global(.cover) {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 40px;
    border-radius: 12px;
  }
  .article :global(.body) {
    margin-top: 40px;
    font-size: 18px;
    line-height: 1.7;
  }
  .article :global(.body h2) {
    margin: 1.8em 0 0.4em;
    font-family: var(--mz-display, inherit);
    font-size: 1.6em;
    line-height: 1.2;
  }
  .article :global(.body h3) {
    margin: 1.5em 0 0.3em;
    font-size: 1.25em;
  }
  .article :global(.body a) {
    color: inherit;
    text-underline-offset: 3px;
  }
  .article :global(.body img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .article :global(.body blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 3px solid currentColor;
    opacity: 0.85;
  }
</style>
