---
/**
 * A page built on the canvas: its sections rendered with the site's theme, exactly as the editor shows them.
 *
 *   <Page sections={entry.data.page} />
 */
import {
  type BoundEntry,
  expandComponents,
  expandGlobals,
  librarySrcset,
  type PageNode,
  pageFontLinks,
  renderPage,
  type Theme,
  walk,
} from '@materializecms/core/page'
import { getComponents, getEntries, getGlobals, getTheme } from '../content.ts'

interface Props {
  sections?: PageNode[] | null
  /** On a template page: the entry it shows (elements with a field take its values). */
  entry?: { title: string; url: string | null; data: Record<string, unknown> }
  /** Defaults to the theme saved in the panel. */
  theme?: Theme
}

const { sections, theme, entry } = Astro.props
const active = theme ?? (await getTheme())
const nodes = expandComponents(expandGlobals(sections ?? [], await getGlobals()), await getComponents())
// Published entries for the lists bound to a collection.
const data: Record<string, BoundEntry[]> = {}
const bound = new Set<string>()
walk(nodes, (n) => {
  if (n.bind?.collection) bound.add(n.bind.collection)
})
for (const name of bound) {
  data[name] = (await getEntries(name).catch(() => [])).map((e) => ({ title: e.title, url: e.url, data: e.data }))
}
const page = entry ? { title: entry.title, url: entry.url, data: entry.data } : undefined
const { html, css } = renderPage(nodes, active, { srcset: librarySrcset, data, entry: page })
---

{pageFontLinks(active, nodes).map((href) => <link rel="stylesheet" href={href} />)}
<style is:inline set:html={css}></style>
<Fragment set:html={html} />

<script>
  // Interactions, smooth scrolling and the custom cursor; does nothing on pages without them.
  import { startMotion } from '@materializecms/core/motion'
  import { startScenes } from '@materializecms/core/scene'

  // Independent: a problem in one never stops the other.
  for (const start of [() => startScenes(document), () => startMotion(document, { site: true })]) {
    try {
      start()
    } catch (error) {
      console.error(error)
    }
  }
</script>
