---
import { expandComponents, expandGlobals, type PageNode } from '@materializecms/core/page'
/**
 * Everything search engines and social networks read in a page's head: title, description,
 * canonical, robots, sharing cards, other languages and structured data. Put it inside <head>.
 */
import { headHtml, markdownPath, pageHead } from '@materializecms/core/seo'
import {
  type Entry,
  firstImage,
  getAlternates,
  getComponents,
  getGlobals,
  getSiteSeo,
  getTrail,
  hasFeed,
  isPost,
  summaryOf,
} from '../content.ts'
import { getRuntime } from '../runtime.ts'

interface Props {
  /** The page; without it (a 404, say) only the title and the site defaults are written. */
  entry?: Entry
  title: string
  description?: string
  /** Name of the site when Impostazioni → SEO has none. */
  siteName?: string
}

const { entry, title, description, siteName } = Astro.props
const saved = await getSiteSeo()
const site = { ...saved, siteName: saved.siteName || siteName }
const { config } = await getRuntime()
const locals = Astro.locals as { materializePreview?: boolean; materializeShare?: boolean }
const live = !locals.materializePreview && !locals.materializeShare
// Canvas pages: components and shared sections hold most of the images.
const page = Array.isArray(entry?.data.page)
  ? expandComponents(expandGlobals(entry.data.page as PageNode[], await getGlobals()), await getComponents())
  : null
const locales = config().locales
// The pages above this one; the home page by the site's name, as Google shows it.
const trail = entry
  ? (await getTrail(entry)).map((e) => ({
      name: e.url === '/' || e.url === `/${e.locale}` ? site.siteName || e.title : e.title,
      url: e.url as string,
    }))
  : undefined
const html = headHtml(
  pageHead({
    title,
    url: entry?.url ?? null,
    locale: entry?.locale ?? locales.default,
    seo: entry?.data.seo,
    site,
    siteUrl: Astro.site,
    alternates: entry ? await getAlternates(entry) : [],
    defaultLocale: locales.default,
    publishedAt: entry?.publishedAt,
    description: description ?? (entry ? await summaryOf(entry) : undefined),
    image: entry ? firstImage(page ?? entry.data) : undefined,
    feed: live && (await hasFeed()) ? '/rss.xml' : undefined,
    markdown: live && entry?.url && saved.llms !== false ? markdownPath(entry.url) : undefined,
    trail,
    article: entry ? await isPost(entry) : false,
  }),
)
---

<Fragment set:html={html} />
