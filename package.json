{
  "name": "materialize-monorepo",
  "private": true,
  "type": "module",
  "description": "Materialize — open source CMS with a Figma-grade visual editor and static, fast sites.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:admin": "npm run dev -w @materializecms/admin",
    "build": "npm run build -w @materializecms/admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/admin/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "release": "node scripts/release.ts --pack",
    "smoke": "node scripts/smoke.ts",
    "bump": "node scripts/bump.ts",
    "publish-release": "node scripts/publish.ts",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.9",
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "astro": "7.4.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
